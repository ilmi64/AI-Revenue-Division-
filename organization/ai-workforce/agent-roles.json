{
  "schema_version": "1.0.0",
  "roles": [
    {
      "id": "executive-coordinator",
      "owner": "ChatGPT",
      "scope": "Cross-division coordination, prioritisation, synthesis, approvals queue and executive reporting",
      "authority": "advisory_and_coordination_only",
      "prohibited": [
        "approve_spending",
        "sign_transactions",
        "place_trades",
        "merge_code",
        "deploy_production"
      ]
