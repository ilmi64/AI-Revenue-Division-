{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/occ/capital-flow-event.schema.json",
  "title": "Capital Flow Intelligence Event",
  "description": "Normalized evidence record for research-only capital-flow observations. Not a trading signal or execution instruction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "observed_at_epoch",
    "ingested_at_epoch",
    "source_ids",
    "evidence_refs",
    "source_reliability",
    "attribution_confidence",
    "event_confidence",
    "materiality",
    "review_status"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "event_type": {
      "enum": [
        "fundraise_announced",
        "grant_announced",
        "investment_disclosed",
        "token_launch_announced",
        "token_distribution",
        "vesting_unlock_scheduled",
        "vesting_unlock_observed",
        "treasury_transfer",
        "treasury_deployment",
        "treasury_withdrawal",
        "large_wallet_transfer",
        "exchange_inflow",
        "exchange_outflow",
        "bridge_inflow",
        "bridge_outflow",
        "wallet_accumulation_candidate",
        "wallet_distribution_candidate",
        "liquidity_added",
        "liquidity_removed",
        "market_maker_transfer",
        "stablecoin_supply_change",
        "stablecoin_netflow",
        "developer_activity_change",
        "grant_activity_change",
        "ecosystem_integration",
        "governance_treasury_proposal",
        "buyback_announced",
        "buyback_executed"
      ]
    },
    "chain": {
      "type": [
        "string",
        "null"
      ]
    },
    "asset_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "contract_address": {
      "type": [
        "string",
        "null"
      ]
    },
    "transaction_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "block_height": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "subject_entity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "counterparty_entity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurred_at_epoch": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "observed_at_epoch": {
      "type": "number",
      "minimum": 0
    },
    "ingested_at_epoch": {
      "type": "number",
      "minimum": 0
    },
    "source_timezone_or_precision": {
      "type": [
        "string",
        "null"
      ]
    },
    "value_native": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "native_unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "value_usd_estimate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "value_cad_estimate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "valuation_at_epoch": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "valuation_source_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "direction": {
      "enum": [
        "inflow",
        "outflow",
        "internal",
        "unknown"
      ]
    },
    "direction_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "raw_evidence_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "corroboration_count": {
      "type": "integer",
      "minimum": 0
    },
    "source_reliability": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "attribution_confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "event_confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "materiality": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_status": {
      "enum": [
        "watch",
        "research",
        "unverified",
        "corroborated",
        "rejected",
        "expired"
      ]
    },
    "revalidate_by_epoch": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  }
}
