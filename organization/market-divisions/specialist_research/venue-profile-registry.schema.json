{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "venue-profile-registry.schema.json",
  "title": "OCC Versioned Venue and Instrument Profile Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profiles"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profiles": {
      "type": "array",
      "items": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_uri", "source_type", "captured_at_utc", "evidence_sha256"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_uri": {"type": "string", "minLength": 1},
        "source_type": {"type": "string", "minLength": 1},
        "captured_at_utc": {"type": "string", "format": "date-time"},
        "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id", "revision", "venue_id", "instrument_id", "instrument_type",
        "effective_from_utc", "profile_state", "verification_state", "review_state",
        "venue_spec", "contract_profile", "provenance"
      ],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "venue_id": {"type": "string", "minLength": 1},
        "instrument_id": {"type": "string", "minLength": 1},
        "instrument_type": {"enum": ["crypto_perpetual", "forex_cfd", "index_future", "index_cfd", "gold_future", "gold_cfd"]},
        "effective_from_utc": {"type": "string", "format": "date-time"},
        "effective_to_utc": {"type": ["string", "null"], "format": "date-time"},
        "profile_state": {"enum": ["unverified", "under_review", "reviewed", "approved", "rejected", "suspended"]},
        "verification_state": {"enum": ["unverified", "source_checked", "independently_corroborated"]},
        "review_state": {"enum": ["not_reviewed", "pending", "accepted", "rejected"]},
        "reviewer_id": {"type": "string", "minLength": 1},
        "reviewed_at_utc": {"type": "string", "format": "date-time"},
        "venue_spec": {"type": "object"},
        "contract_profile": {"$ref": "contract-lifecycle-profile.schema.json"},
        "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenance"}}
      },
      "allOf": [
        {
          "if": {"properties": {"profile_state": {"const": "approved"}}},
          "then": {
            "required": ["reviewer_id", "reviewed_at_utc"],
            "properties": {
              "review_state": {"const": "accepted"},
              "verification_state": {"enum": ["source_checked", "independently_corroborated"]}
            }
          }
        }
      ]
    }
  }
}
