{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/occ/unified-intake.schema.json",
  "title": "OCC Unified Research Intelligence Snapshot",
  "description": "Offline research-only aggregate of specialist desk packets, evidence provenance, Capital Flow context, stop state and shift handover.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_type",
    "generated_at_utc",
    "status",
    "mode",
    "desk_coverage",
    "missing_desks",
    "coverage_complete",
    "specialist_packets",
    "capital_flow_audit",
    "capital_flow_context",
    "evidence_index",
    "packet_validation_errors",
    "active_stops",
    "global_stop_active",
    "handover",
    "replay_evidence_gate",
    "occ",
    "authority",
    "trade_authority",
    "live_readiness",
    "limitations",
    "control_health"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "snapshot_type": {
      "const": "unified_occ_research_intelligence"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "research",
        "unverified",
        "halt"
      ]
    },
    "mode": {
      "const": "research_only"
    },
    "desk_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crypto",
        "forex",
        "indices",
        "gold"
      ],
      "properties": {
        "crypto": {
          "type": "integer",
          "minimum": 0
        },
        "forex": {
          "type": "integer",
          "minimum": 0
        },
        "indices": {
          "type": "integer",
          "minimum": 0
        },
        "gold": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "missing_desks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "crypto",
          "forex",
          "indices",
          "gold"
        ]
      }
    },
    "coverage_complete": {
      "type": "boolean"
    },
    "specialist_packets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "capital_flow_context": {
      "type": "object"
    },
    "evidence_index": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "desk_id",
            "instrument_id",
            "evidence_type"
          ],
          "properties": {
            "desk_id": {
              "type": "string"
            },
            "instrument_id": {
              "type": "string"
            },
            "evidence_type": {
              "enum": [
                "market_observation",
                "capital_flow_event"
              ]
            }
          }
        }
      }
    },
    "packet_validation_errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "active_stops": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "global_stop_active": {
      "type": "boolean"
    },
    "handover": {
      "type": "object",
      "required": [
        "status",
        "accepted",
        "errors"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_provided",
            "accepted",
            "blocked"
          ]
        },
        "accepted": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "active_veto_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "replay_evidence_gate": {
      "type": "object"
    },
    "occ": {
      "type": "object",
      "required": [
        "status",
        "desk_count",
        "packet_count",
        "authority",
        "trade_authority",
        "live_readiness"
      ],
      "properties": {
        "status": {
          "enum": [
            "research",
            "unverified",
            "halt"
          ]
        },
        "desk_count": {
          "type": "integer",
          "minimum": 0
        },
        "packet_count": {
          "type": "integer",
          "minimum": 0
        },
        "portfolio_version": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "authority": {
          "const": "coordination_and_stop_veto_only"
        },
        "trade_authority": {
          "const": false
        },
        "live_readiness": {
          "const": false
        }
      }
    },
    "authority": {
      "const": "research_only_no_execution_authority"
    },
    "trade_authority": {
      "const": false
    },
    "live_readiness": {
      "const": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "control_health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "snapshot_history_integrity",
        "event_ledger_integrity",
        "cross_ledger_consistency",
        "handover_acceptance",
        "handover_count",
        "latest_verified_snapshot_id",
        "active_stop_ids",
        "open_incidents",
        "unresolved_critical_items",
        "continuity_gaps",
        "errors",
        "warnings",
        "authority",
        "trade_authority",
        "live_readiness",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "status": {
          "enum": [
            "PASS_AUDIT",
            "WARN_AUDIT",
            "HALT_AUDIT",
            "NOT_PROVIDED"
          ]
        },
        "snapshot_history_integrity": {
          "enum": [
            "valid",
            "invalid_or_missing"
          ]
        },
        "event_ledger_integrity": {
          "enum": [
            "valid",
            "invalid_or_missing"
          ]
        },
        "cross_ledger_consistency": {
          "enum": [
            "consistent",
            "inconsistent"
          ]
        },
        "handover_acceptance": {
          "enum": [
            "accepted",
            "blocked",
            "not_provided"
          ]
        },
        "handover_count": {
          "type": "integer",
          "minimum": 0
        },
        "latest_verified_snapshot_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "active_stop_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "open_incidents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved_critical_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "continuity_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authority": {
          "const": "research_only_no_execution_authority"
        },
        "trade_authority": {
          "const": false
        },
        "live_readiness": {
          "const": false
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "capital_flow_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "instrument_count",
        "accepted_event_count",
        "rejected_event_count",
        "instruments",
        "boundary_errors",
        "mode",
        "trade_authority",
        "live_readiness"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_consumed",
            "provided_no_eligible_match",
            "consumed_research_context",
            "blocked"
          ]
        },
        "instrument_count": {
          "type": "integer",
          "minimum": 0
        },
        "accepted_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "instruments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "instrument_id",
              "status",
              "accepted_event_ids",
              "rejected_events",
              "trade_authority",
              "live_readiness"
            ],
            "properties": {
              "instrument_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": "string"
              },
              "accepted_event_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rejected_events": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "review_ledger": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "trade_authority": {
                "const": false
              },
              "live_readiness": {
                "const": false
              },
              "accepted_event_summaries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "event_id",
                    "event_classification"
                  ],
                  "properties": {
                    "event_id": {
                      "type": "string"
                    },
                    "event_classification": {
                      "type": "object",
                      "required": [
                        "category",
                        "subtype",
                        "classification_status",
                        "materiality_tier",
                        "source_independence_verified",
                        "research_only",
                        "trade_authority"
                      ],
                      "properties": {
                        "category": {
                          "type": "string"
                        },
                        "subtype": {
                          "type": "string"
                        },
                        "classification_status": {
                          "enum": [
                            "classified",
                            "unclassified"
                          ]
                        },
                        "materiality_score": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 0,
                          "maximum": 5
                        },
                        "materiality_tier": {
                          "enum": [
                            "unknown",
                            "low",
                            "moderate",
                            "high",
                            "critical"
                          ]
                        },
                        "source_count": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "claimed_corroboration_count": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 0
                        },
                        "corroboration_assessment": {
                          "type": "string"
                        },
                        "source_independence_verified": {
                          "const": false
                        },
                        "direction": {
                          "enum": [
                            "inflow",
                            "outflow",
                            "internal",
                            "unknown"
                          ]
                        },
                        "research_only": {
                          "const": true
                        },
                        "trade_authority": {
                          "const": false
                        }
                      }
                    },
                    "evidence_provenance": {
                      "type": "object",
                      "required": [
                        "status",
                        "evidence_item_count",
                        "evidence_refs_without_metadata",
                        "metadata_errors",
                        "distinct_declared_publishers",
                        "distinct_canonical_sources",
                        "distinct_source_families",
                        "declared_independence_groups",
                        "independent_corroboration_established",
                        "independence_assessment",
                        "authentication_status",
                        "timestamp_trust_status"
                      ],
                      "properties": {
                        "status": {
                          "enum": [
                            "metadata_complete_unverified",
                            "incomplete"
                          ]
                        },
                        "evidence_item_count": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "evidence_refs_without_metadata": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "metadata_errors": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "distinct_declared_publishers": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "distinct_canonical_sources": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "distinct_source_families": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "declared_independence_groups": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "independent_corroboration_established": {
                          "const": false
                        },
                        "independence_assessment": {
                          "type": "string"
                        },
                        "evidence": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        "authentication_status": {
                          "const": "not_authenticated"
                        },
                        "timestamp_trust_status": {
                          "const": "publisher_claim_not_independently_verified"
                        }
                      }
                    },
                    "research_priority": {
                      "type": "object",
                      "required": [
                        "priority",
                        "reasons",
                        "review_queue_only",
                        "not_a_directional_signal",
                        "not_a_market_observation",
                        "trade_authority",
                        "live_readiness"
                      ],
                      "properties": {
                        "priority": {
                          "enum": [
                            "blocked_from_priority_queue",
                            "insufficient_provenance",
                            "insufficient_evidence",
                            "high_review_priority",
                            "standard_review_priority",
                            "low_review_priority"
                          ]
                        },
                        "reasons": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "review_queue_only": {
                          "const": true
                        },
                        "not_a_directional_signal": {
                          "const": true
                        },
                        "not_a_market_observation": {
                          "const": true
                        },
                        "trade_authority": {
                          "const": false
                        },
                        "live_readiness": {
                          "const": false
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "boundary_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "const": "research_only"
        },
        "trade_authority": {
          "const": false
        },
        "live_readiness": {
          "const": false
        }
      }
    }
  }
}
