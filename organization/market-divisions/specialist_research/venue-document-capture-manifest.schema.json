{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "venue-document-capture-manifest.schema.json",
  "title": "OCC Partial Official Venue Document Capture Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_status",
    "capture_date",
    "capture_time_precision",
    "captured_at_utc",
    "method",
    "global_controls",
    "captures",
    "candidate_coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "manifest_status": {
      "const": "PARTIAL_OFFICIAL_EXCERPT_CAPTURE_NOT_FULL_DOCUMENTS"
    },
    "capture_date": {
      "type": "string",
      "format": "date"
    },
    "capture_time_precision": {
      "const": "date_only_normalized_to_utc_midnight"
    },
    "captured_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "global_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_document_capture",
        "source_authentication",
        "publisher_identity_verified",
        "source_timestamp_trusted",
        "automatic_profile_update",
        "profile_approval",
        "trade_authority",
        "live_readiness",
        "research_only"
      ],
      "properties": {
        "full_document_capture": {
          "const": false
        },
        "source_authentication": {
          "const": "NOT_PERFORMED"
        },
        "publisher_identity_verified": {
          "const": false
        },
        "source_timestamp_trusted": {
          "const": false
        },
        "automatic_profile_update": {
          "const": false
        },
        "profile_approval": {
          "const": false
        },
        "trade_authority": {
          "const": false
        },
        "live_readiness": {
          "const": false
        },
        "research_only": {
          "const": true
        }
      }
    },
    "captures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision_id",
          "document_id",
          "candidate_ids",
          "canonical_uri",
          "title",
          "publisher",
          "source_class",
          "source_ref",
          "content_sha256",
          "document_text",
          "extracted_facts",
          "known_gaps",
          "capture_scope",
          "full_document_capture",
          "capture_time_precision",
          "captured_at_utc",
          "retrieval_method"
        ],
        "properties": {
          "revision_id": {
            "type": "string",
            "minLength": 1
          },
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "candidate_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "canonical_uri": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "source_class": {
            "enum": [
              "official_contract_specification",
              "official_margin_schedule",
              "official_financing_policy",
              "official_product_page",
              "official_help_centre",
              "regulator_notice",
              "exchange_rulebook",
              "broker_client_agreement",
              "third_party_reference",
              "research_note",
              "official_api_schema",
              "official_api_endpoint_definition"
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "document_text": {
            "type": "string",
            "minLength": 1
          },
          "extracted_facts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "fact_key",
                "value"
              ],
              "properties": {
                "fact_key": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {},
                "unit": {
                  "type": "string"
                },
                "source_locator": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "known_gaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capture_scope": {
            "enum": [
              "official_page_search_excerpt",
              "official_api_definition_excerpt",
              "official_api_endpoint_excerpt"
            ]
          },
          "full_document_capture": {
            "const": false
          },
          "capture_time_precision": {
            "const": "date_only_normalized_to_utc_midnight"
          },
          "captured_at_utc": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "retrieval_method": {
            "enum": [
              "official_web_search_excerpt",
              "official_web_open_excerpt"
            ]
          }
        }
      }
    },
    "candidate_coverage": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "document_ids"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "document_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
